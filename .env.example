# Copy this file to .env and adjust the values. .env is git-ignored.
# These values are for local development only.

POSTGRES_DB=arcade
POSTGRES_USER=arcade
POSTGRES_PASSWORD=change-me

# Signs login tokens. At least 32 characters; use a long random value outside local development.
JWT_SECRET=local-development-only-jwt-secret-change-me

# Optional. Comma-separated browser origins allowed to open the WebSocket. Default: http://localhost:5173
# WS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Local development only: seeds the demo users alice and bob at backend startup.
# scripts/dev-reset.sh sets this for you, so you normally leave it commented out.
# ARCADE_SEED_ENABLED=false
